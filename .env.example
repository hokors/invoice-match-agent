# Copy to .env and fill in. Never commit .env.

# Password for the Postgres user Odoo connects as (local sandbox only).
PG_PASSWORD=change-me

# Odoo API access for the agent (filled in after Odoo is set up).
ODOO_URL=http://localhost:8069
ODOO_DB=lakan
ODOO_API_KEY=

# Gemini API key for invoice extraction.
GEMINI_API_KEY=
